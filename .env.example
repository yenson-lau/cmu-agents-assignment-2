# Inference backend: 'modal' or 'openrouter'. The validator and the generation
# agents follow it unless overridden individually below.
INFERENCE_BACKEND=openrouter
VALIDATOR_BACKEND=${INFERENCE_BACKEND}
GENERATION_BACKEND=${INFERENCE_BACKEND}


# Modal
# -----
# Endpoint URLs have the form https://<workspace>--<app>-<class>-serve.<domain>.
# Copy both values from the URLs the deploy scripts print; the domain may
# include a region (e.g. us-east.modal.run) or be plain modal.run.
MODAL_WORKSPACE=<modal-workspace>
MODAL_DOMAIN=us-east.modal.run

# Keep the /v1 suffix on every endpoint URL.
VALIDATOR_BASE_URL=https://${MODAL_WORKSPACE}--hw2-validator-model-validatorserver-serve.${MODAL_DOMAIN}/v1

# Your own Modal proxy token in combined form: <token-id>.<token-secret>.
# This is needed to call the endpoint, but not to deploy it.
VALIDATOR_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx

# Stable alias exposed by infrastructure/validator_model.py.
VALIDATOR_MODEL=validator

GENERATION_QWEN_BASE_URL=https://${MODAL_WORKSPACE}--hw2-generation-models-qwenserver-serve.${MODAL_DOMAIN}/v1
GENERATION_MINISTRAL_BASE_URL=https://${MODAL_WORKSPACE}--hw2-generation-models-ministralserver-serve.${MODAL_DOMAIN}/v1
GENERATION_GLM_BASE_URL=https://${MODAL_WORKSPACE}--hw2-generation-models-glmserver-serve.${MODAL_DOMAIN}/v1

# The same workspace proxy token authenticates all three generation endpoints.
GENERATION_API_KEY=wk-xxxxxxxx.ws-xxxxxxxx


# OpenRouter
# ----------
# Per-role models and provider pins are not secrets, so they live in
# infrastructure/backends.toml rather than here.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-<your-key>
